name "dssh"
description "Pure-D SSH-2.0 client library"
authors "Hiroki Noda"
copyright "Copyright © 2026, Hiroki Noda"
license "BSL-1.0"
dependency "openssl" version="~>3.0"
targetType "library"
subPackage {
	name "vibe"
	dependency "vibe-core" version="~>2.0"
	dependency "dssh" version="*"
	targetType "library"
	sourcePaths "vibe/source"
	importPaths "vibe/source"
}
